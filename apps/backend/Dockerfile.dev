FROM node:26-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797
RUN apk add --no-cache tzdata
ENV TZ=Europe/Rome
WORKDIR /app
RUN npm install -g corepack@0.36.0 && corepack enable

# Cache layer: solo i manifesti (prima di COPY . . per sfruttare cache Docker)
COPY package.json pnpm-workspace.yaml .npmrc pnpm.yaml ./
# Versione di pnpm (con hash sha512, verificato da corepack) dal campo packageManager
# di package.json: unica fonte, letta anche da pnpm/action-setup nei workflow.
RUN corepack install
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/backend/package.json ./apps/backend/

# Install senza script (evita ERR_PNPM_IGNORED_BUILDS di pnpm v10+)
RUN pnpm install --ignore-scripts

COPY . .

# shared-types va compilato esplicitamente ("main"/"types" puntano a ./dist,
# mai a ./src — vedi commento in apps/backend/Dockerfile per il motivo: Node
# blocca il type-stripping nativo per file sotto node_modules, e in produzione
# il pacchetto finisce realmente lì). In dev il bind mount di packages/shared-types/src
# sovrascrive solo i sorgenti, non dist/: dopo una modifica a shared-types
# serve un rebuild del container (stesso pattern già documentato per modifiche
# fuori da src/ o a package.json).
RUN node_modules/.bin/tsc -p packages/shared-types/tsconfig.cjs.json && node_modules/.bin/tsc -p packages/shared-types/tsconfig.esm.json
RUN echo '{"type":"module"}' > packages/shared-types/dist/esm/package.json

EXPOSE 8080
# Usa il binario direttamente — bypassa il deps-check di pnpm v11 al runtime
WORKDIR /app/apps/backend
CMD ["node_modules/.bin/nest", "start", "--watch"]
